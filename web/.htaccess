DirectoryIndex index.php

<Files "api.php">
  LimitRequestBody 65536
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(app|config|data|var)(/|$) - [F,L]
</IfModule>

<FilesMatch "^(\.env|bootstrap_setup\.txt|composer\.(json|lock)|.*\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
